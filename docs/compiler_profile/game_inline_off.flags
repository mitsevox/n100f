# game.flags with -inline off, which keeps small inline helpers (xMat3x3RMulVec) as
# standalone bodies so they can be compared with out-of-line copies in the target.
-nodefaults -proc gekko -align powerpc -enum int -fp hardware -Cpp_exceptions off
-O4,s -inline off -pragma "cats off" -pragma "warn_notinlined off"
-maxerrors 1 -nosyspath -RTTI off -fp_contract on -str reuse -multibyte
-i include -i src/PowerPC_EABI_Support/include -i src/dolphin/include -i src/dolphin/src
-i src/bink/include -i src/bink/src -i src
-DNDEBUG=1 -W off
-lang=c++ -common off -char signed -str reuse,readonly -use_lmw_stmw on
-pragma "cpp_extensions on" -gccinc
-i include/inline -i include/rwsdk -i src/SB/Core/gc -i src/SB/Core/x -i src/SB/Game -DGAMECUBE
